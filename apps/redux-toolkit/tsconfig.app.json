{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/auth/*": ["./src/auth/*"],
      "@/features/*": ["./src/features/*"],
      "@/routing/*": ["./src/routing/*"],
      "@/state/*": ["./src/state/*"],
      "@/theme/*": ["./src/theme/*"],
      "@/utilities/*": ["./src/utilities/*"]
    }
  },
  "include": ["src"]
}
