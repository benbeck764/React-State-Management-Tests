{
  "name": "@spotify-examples/redux-toolkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && vite build",
    "clean": "pnpm clean:packages & pnpm clean:dist",
    "clean:dist": "rimraf dist",
    "clean:packages": "rimraf node_modules",
    "eslint": "eslint . --max-warnings 0",
    "lint": "pnpm eslint && pnpm type-check",
    "prettier": "prettier --write",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit"
  },
  "proxy": "http://localhost:5173",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "@spotify-examples/components": "workspace:*",
    "@spotify-examples/spotify-api": "workspace:*",
    "@spotify-examples/spotify-auth": "workspace:*",
    "@spotify-examples/utilities": "workspace:*",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.18.0"
  }
}
