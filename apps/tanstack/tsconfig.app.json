{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "paths": {
      "@/api/*": ["./src/api/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/auth/*": ["./src/auth/*"],
      "@/components/*": ["./src/components/*"],
      "@/features/*": ["./src/features/*"],
      "@/mutations/*": ["./src/mutations/*"],
      "@/queries/*": ["./src/queries/*"],
      "@/routing/*": ["./src/routing/*"]
    }
  },
  "include": ["src"]
}
