{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "sourceMap": false,

    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/theme/*": ["./src/theme/*"],
      "@/utilities/*": ["./src/utilities/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
